---
/**
 * Where rulecast sits between the agent and its tools. Facts from the spec's event table (§7) and
 * Claude Code hook table (§12); only what a user needs, so no UserPromptSubmit or SubagentStop.
 */
interface Step {
  when: string
  hooks: string
  says: string
}

const steps: Step[] = [
  {
    when: "Session starts",
    hooks: "start",
    says: "rulecast records the working tree, so it can tell later what changed.",
  },
  { when: "Reads a file", hooks: "touch", says: "The conventions for that file arrive once, with their doc sections." },
  {
    when: "Edits a file",
    hooks: "guard · edit",
    says: "A protected file is refused before the write. Anything else is checked after it, and new findings come back in the same turn.",
  },
  {
    when: "Runs a command",
    hooks: "shell-before · shell-after",
    says: "What the command wrote is checked like an edit. A protected file it touched must be reverted.",
  },
  {
    when: "Tries to stop",
    hooks: "verify",
    says: "It is held back while a new error stands, once per prompt by default. Changes no tool call explains are reported and never block.",
  },
]
---

<dl class="rc-flow not-content">
  {
    steps.map((step) => (
      <div class="rc-flow-row">
        <dt>
          {step.when}
          <code>{step.hooks}</code>
        </dt>
        <dd>{step.says}</dd>
      </div>
    ))
  }
</dl>

<style>
  .rc-flow {
    margin: 0;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .rc-flow-row {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr;
    gap: 0.35rem 2rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .rc-flow dt {
    display: grid;
    gap: 0.2rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rc-flow code {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    color: var(--sl-color-gray-3);
    background: none;
    padding: 0;
  }
  .rc-flow dd {
    margin: 0;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  @media (max-width: 40rem) {
    .rc-flow-row {
      grid-template-columns: 1fr;
    }
  }
</style>
