---
/**
 * Starlight's header, plus a menu button on pages without a sidebar (the landing page): there, the
 * docs are otherwise one link away from nowhere.
 */
import Default from "@astrojs/starlight/components/Header.astro"
import SiteMenu from "./SiteMenu.astro"

const { hasSidebar } = Astro.locals.starlightRoute
---

{
  hasSidebar ? (
    <Default />
  ) : (
    <div class="rc-header">
      <SiteMenu />
      <div class="rc-header-rest">
        <Default />
      </div>
    </div>
  )
}

<style>
  .rc-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
  }
  .rc-header-rest {
    flex: 1;
    min-width: 0;
    height: 100%;
  }
</style>
