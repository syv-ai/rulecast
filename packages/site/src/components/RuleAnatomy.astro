---
/**
 * The README's example rule beside the output it produces, built by scripts/anatomy.ts.
 */
import { anatomy } from "../../scripts/anatomy"

const { ruleHtml, outputHtml } = anatomy()
---

<figure class="rc-anatomy not-content">
  <div class="rc-anatomy-pane">
    <figcaption><code>.rulecast-config.yaml</code></figcaption>
    <pre set:html={ruleHtml} />
  </div>
  <div class="rc-anatomy-pane">
    <figcaption>What the agent receives</figcaption>
    <pre set:html={outputHtml} />
  </div>
</figure>

<style is:global>
  .rc-anatomy {
    display: grid;
    /* Side by side where both panes have room, stacked in a docs column or on a phone. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    margin: 0;
  }
  .sl-markdown-content .rc-anatomy {
    margin-top: 1.5rem;
  }
  .rc-anatomy-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .rc-anatomy figcaption {
    margin-bottom: 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .rc-anatomy figcaption code {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .rc-anatomy pre {
    flex: 1;
    margin: 0;
    padding: 1.1rem 1.25rem;
    border: 0;
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-4);
    font-family: var(--__sl-font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .rc-a-lit {
    color: var(--sl-color-white);
  }
  .rc-a-value {
    color: var(--sl-color-accent);
  }
</style>
