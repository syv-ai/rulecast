---
/**
 * The landing page's hero. Its words are the README's first two paragraphs, read at build time, and
 * the version is the CLI package's.
 */
import { routeUrl } from "../../scripts/links"
import { LEAD, readme, version } from "../../scripts/sources"
import logo from "../assets/logo-light.svg"

const paragraphs = (readme().get(LEAD) ?? "").split(/\n\n+/).filter((block) => !block.startsWith("```"))
/** Inline Markdown in the README's lead: code and emphasis are all it uses. */
const inline = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*([^*]+)\*/g, "<em>$1</em>")
const [tagline = "", lede = ""] = paragraphs
---

<header class="rc-hero">
  <img src={logo.src} alt="" width="88" height="88" class="rc-hero-logo" />
  <h1>rulecast</h1>
  <p class="rc-hero-tagline" set:html={inline(tagline)} />
  <p class="rc-hero-lede" set:html={inline(lede)} />
  <div class="rc-hero-actions">
    <a class="rc-button rc-button-primary" href={routeUrl("getting-started")}>Get started</a>
    <a class="rc-button" href={routeUrl("how-it-works")}>How it works</a>
    <a class="rc-button" href="https://github.com/syv-ai/rulecast">GitHub</a>
  </div>
  <p class="rc-hero-facts">
    <span>v{version()}</span>
    <span>Claude Code</span>
    <span>Node ≥ 20.12</span>
    <span>Linux · macOS</span>
    <span>MIT</span>
  </p>
</header>

<style is:global>
  /* The splash page's own title panel: the hero carries the page's h1. */
  .content-panel:has(> .sl-container > h1#_top) {
    display: none;
  }
</style>

<style>
  .rc-hero {
    text-align: center;
    max-width: 46rem;
    margin: 1rem auto 0;
  }
  .rc-hero-logo {
    display: block;
    margin: 0 auto;
    border-radius: 1.2rem;
    box-shadow: 0 12px 32px -14px rgb(255 106 61 / 0.55);
  }
  .rc-hero h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
    line-height: 1.05;
  }
  .rc-hero-tagline {
    font-size: clamp(1.1rem, 2.6vw, 1.35rem);
    color: var(--sl-color-gray-1);
    line-height: 1.5;
  }
  .rc-hero-lede {
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  .rc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .rc-button {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-white);
    text-decoration: none;
    font-weight: 600;
  }
  .rc-button:hover {
    border-color: var(--sl-color-accent);
  }
  .rc-button-primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .rc-button-primary:hover {
    background: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }
  .rc-hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-size: var(--sl-text-xs);
  }
  .rc-hero-facts span {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }
</style>
