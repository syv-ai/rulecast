---
/**
 * An agent gets a finding and fixes it. Every line rulecast prints here is real output, read at
 * build time: the README's opening block (which the README says is real output) and the renderer's
 * recorded `shell-edit` golden. Only the agent's own actions are written here.
 *
 * The page renders the whole session; the script replays it line by line. Without JavaScript, or
 * with reduced motion, the whole session simply shows.
 */
import { golden, openingOutput } from "../../scripts/sources"

type Line = { kind: "agent" | "rulecast" | "note"; text: string }

const agent = (text: string): Line => ({ kind: "agent", text })
const note = (text: string): Line => ({ kind: "note", text })
const output = (text: string): Line[] =>
  text
    .trimEnd()
    .split("\n")
    .map((line) => ({ kind: "rulecast", text: line }))

const session: Line[] = [
  agent("Edit app/services/users.py"),
  ...output(openingOutput()),
  agent("Edit app/services/users.py"),
  note("(nothing new: rulecast stays quiet)"),
  agent("Bash python scripts/scaffold_service.py users"),
  ...output(golden("shell-edit")),
]

/** A delivered doc section, from its `--- file#anchor ---` header to the end of that output. */
function withBands(input: Line[]): (Line & { band: boolean })[] {
  let inSection = false
  return input.map((line) => {
    if (line.kind !== "rulecast") inSection = false
    else if (/^-{3} .* -{3}$/.test(line.text)) inSection = true
    return { ...line, band: inSection }
  })
}
const lines = withBands(session)

/** How a line of rulecast's output is coloured. */
function tone(text: string): string {
  if (/^rulecast:/.test(text)) return "rc-t-title"
  if (/^error /.test(text)) return "rc-t-error"
  if (/^warning /.test(text)) return "rc-t-warning"
  if (/^--- .* ---$/.test(text)) return "rc-t-section"
  return ""
}
---

<figure class="rc-terminal not-content" aria-label="An agent session with rulecast: real rulecast output">
  <div class="rc-term-body" data-rc-terminal>
    {
      lines.map((line) =>
        line.kind === "agent" ? (
          <div class="rc-term-line rc-t-agent" data-kind="agent">
            <span class="rc-t-prompt" aria-hidden="true">
              ›
            </span>
            <span data-text>{line.text}</span>
          </div>
        ) : line.kind === "note" ? (
          <div class="rc-term-line rc-t-note" data-kind="note">
            {line.text}
          </div>
        ) : (
          <div class:list={["rc-term-line", "rc-t-out", tone(line.text), { "rc-t-band": line.band }]} data-kind="rulecast">
            {line.text === "" ? "\u00a0" : line.text}
          </div>
        ),
      )
    }
  </div>
</figure>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

  /**
   * Replays the session while it is on screen. The whole session is in the HTML, so without
   * JavaScript, or with reduced motion, it simply shows; with them, it is cleared before anyone
   * scrolls to it, so it is never seen finished and then wiped.
   */
  function replay(body: HTMLElement) {
    const lines = [...body.querySelectorAll<HTMLElement>(".rc-term-line")]
    const clear = () => {
      for (const line of lines) line.classList.add("rc-hidden")
    }
    clear()

    let visible = false
    let wake: (() => void) | null = null
    new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? false
        if (visible) wake?.()
      },
      { threshold: 0.35 },
    ).observe(body)
    const onScreen = () => (visible ? Promise.resolve() : new Promise<void>((resolve) => (wake = resolve)))

    const play = async () => {
      for (;;) {
        await onScreen()
        await wait(400)
        for (const line of lines) {
          const kind = line.dataset.kind
          if (kind === "agent") {
            const text = line.querySelector<HTMLElement>("[data-text]")!
            const full = text.dataset.full ?? text.textContent ?? ""
            text.dataset.full = full
            text.textContent = ""
            line.classList.remove("rc-hidden")
            for (let i = 1; i <= full.length; i++) {
              text.textContent = full.slice(0, i)
              await wait(24)
            }
            await wait(450)
          } else {
            line.classList.remove("rc-hidden")
            await wait(kind === "note" ? 1400 : 60)
          }
          // A pause after each block of output, so it can be read.
          const next = line.nextElementSibling as HTMLElement | null
          if (kind === "rulecast" && next?.dataset.kind !== "rulecast") await wait(2600)
        }
        await wait(4000)
        // Fade the finished session out as one, rather than blinking it off.
        body.classList.add("rc-fading")
        await wait(320)
        clear()
        body.classList.remove("rc-fading")
      }
    }
    void play()
  }

  if (!reduced) {
    for (const body of document.querySelectorAll<HTMLElement>("[data-rc-terminal]")) replay(body)
  }
</script>

<style>
  .rc-terminal {
    margin: 0;
    border-radius: 1rem;
    background: var(--rc-term-bg);
    color: var(--rc-term-dim);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.5);
    text-align: left;
  }
  .rc-term-body {
    padding: 1.5rem 1.6rem 1.75rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.8rem;
    line-height: 1.65;
    transition: opacity 300ms ease;
  }
  .rc-term-body.rc-fading {
    opacity: 0;
  }
  .rc-term-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    transition: opacity 200ms ease;
  }
  .rc-hidden {
    opacity: 0;
    transition: none;
  }
  .rc-t-agent {
    margin-top: 1.1rem;
    color: #ffffff;
  }
  .rc-t-agent:first-child {
    margin-top: 0;
  }
  .rc-t-prompt {
    color: var(--rc-signal);
    margin-right: 0.6rem;
  }
  .rc-t-out {
    padding-left: 1.3rem;
  }
  .rc-t-title {
    color: var(--rc-term-fg);
  }
  .rc-t-error {
    color: var(--rc-error);
  }
  .rc-t-warning {
    color: var(--rc-warning);
  }
  .rc-t-section {
    color: var(--rc-syn-var);
  }
  /* The same band as the section in the docs and the rule above it. */
  .rc-t-band {
    margin: 0 -1.6rem;
    padding-left: calc(1.3rem + 1.6rem);
    background: rgb(127 164 214 / 0.12);
    color: var(--rc-term-fg);
  }
  .rc-t-note {
    padding-left: 1.3rem;
    font-style: italic;
  }
  @media (max-width: 40rem) {
    .rc-term-body {
      padding: 1.1rem 1.1rem 1.25rem;
      font-size: 0.74rem;
    }
    .rc-t-band {
      margin: 0 -1.1rem;
      padding-left: calc(1.3rem + 1.1rem);
    }
  }
</style>
