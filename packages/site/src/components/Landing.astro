---
/**
 * The landing page. The name and one command; what rulecast is, in plain words; a convention
 * becoming a rule becoming what the agent hears; where it runs; and the
 * prompt that has an agent set it up, which is the README's own (read at build time).
 */
import { Icon } from "@astrojs/starlight/components"
import { routeUrl } from "../../scripts/links"
import { agentPrompt } from "../../scripts/sources"
import ConventionFlow from "./ConventionFlow.astro"
import HookFlow from "./HookFlow.astro"

const install = "npx @syv-ai/rulecast init"
const prompt = agentPrompt()
const next = [
  { title: "Getting started", text: "One command sets it up.", route: "getting-started" },
  { title: "Writing rules", text: "A check, a message, a doc section.", route: "guides/writing-rules" },
  { title: "Detectors", text: "From a regex to a model.", route: "reference/detectors" },
  { title: "Git hooks and CI", text: "The same rules, everywhere.", route: "guides/git-hooks-ci" },
]
---

<div class="rc-landing not-content">
  <header class="rc-hero">
    <h1>rulecast</h1>
    <p class="rc-hero-tagline">Make your rules and conventions enforceable. Inject them when they matter.</p>
    <div class="rc-hero-actions">
      <button class="rc-install" type="button" data-copy={install} aria-label={`Copy ${install}`}>
        <span class="rc-install-prompt" aria-hidden="true">$</span>
        <code>{install}</code>
        <span class="rc-copy-state" aria-live="polite">Copy</span>
      </button>
    </div>
    <div class="rc-hero-links">
      <a class="rc-link" href="#agent-setup">Copy setup prompt <span aria-hidden="true">↓</span></a>
      <a class="rc-link" href={routeUrl("getting-started")}>Read the guide <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <section class="rc-why">
    <p>
      Rulecast helps enforce your conventions in your codebase. It taps into agent hooks and injects your conventions
      when they are relevant. You can think of it as guardrails + progressive disclosure of rules. Could we just write
      everything down directly in agent hooks? Yes, absolutely. But with rulecast we can tie in our documented
      conventions and limit repeat instructions too.
    </p>
    <p>
      Ideally, each convention becomes a rule. When, for example, an edit breaks one, the agent hears about it right
      away, with the part of your docs that explains why, and fixes the code before it moves on. The same rules can run
      in your git hooks and CI, so nothing slips past there either.
    </p>
    <p>
      <a class="rc-quiet-link" href="#agent-setup">
        Ask your agent about Rulecast today.<Icon name="link" size="0.95em" class="rc-quiet-link-icon" />
      </a>
    </p>
  </section>

  <section>
    <ConventionFlow />
  </section>

  <section>
    <h2>Around the tools it already uses.</h2>
    <p class="rc-lede">rulecast runs as your agent's hooks. Nothing to start, no daemon.</p>
    <HookFlow />
  </section>

  <section id="agent-setup">
    <h2>Let your agent set it up.</h2>
    <p class="rc-lede">Paste this into your coding agent. It installs rulecast, then shows you every file it changed.</p>
    <div class="rc-prompt">
      <pre>{prompt}</pre>
      <button class="rc-prompt-copy" type="button" data-copy={prompt} aria-label="Copy the prompt">
        <span class="rc-copy-state" aria-live="polite">Copy</span>
      </button>
    </div>
  </section>

  <nav class="rc-next" aria-label="Read on">
    {
      next.map((item) => (
        <a href={routeUrl(item.route)}>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </a>
      ))
    }
  </nav>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const state = button.querySelector<HTMLElement>(".rc-copy-state")!
    let timer: ReturnType<typeof setTimeout> | undefined
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
        state.textContent = "Copied"
        button.classList.add("rc-copied")
      } catch {
        state.textContent = "Select to copy"
      }
      clearTimeout(timer)
      timer = setTimeout(() => {
        state.textContent = "Copy"
        button.classList.remove("rc-copied")
      }, 1600)
    })
  }
</script>

<style is:global>
  /* The splash page's own title panel: the hero carries the page's h1. */
  .content-panel:has(> .sl-container > h1#_top) {
    display: none;
  }
</style>

<style>
  .rc-landing {
    max-width: 52rem;
    margin: 0 auto;
  }
  .rc-landing section {
    margin-top: clamp(5rem, 12vw, 8rem);
  }
  .rc-landing h1,
  .rc-landing h2 {
    color: var(--sl-color-white);
    font-weight: 650;
    text-wrap: balance;
  }

  .rc-hero {
    margin-top: clamp(2rem, 8vw, 5rem);
    text-align: center;
  }
  .rc-hero h1 {
    margin: 0 auto;
    max-width: 14em;
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .rc-hero-tagline {
    margin: 1.5rem auto 0;
    max-width: 34em;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .rc-hero-actions {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .rc-hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.25rem;
  }
  .rc-install {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.8rem 0.8rem 1.1rem;
    border: 0;
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
    transition:
      transform 160ms var(--rc-ease-out),
      background-color 150ms ease;
  }
  .rc-install:active {
    transform: scale(var(--rc-press));
  }
  .rc-install code {
    white-space: nowrap;
    font-family: var(--__sl-font-mono);
    font-size: 0.95rem;
    background: none;
    padding: 0;
    color: inherit;
  }
  .rc-install-prompt {
    font-family: var(--__sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .rc-copy-state {
    min-width: 4.2rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-5);
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  /* Copied: the pill answers in the accent, so the change reads before the word does. */
  .rc-copied .rc-copy-state {
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }
  .rc-link {
    color: var(--sl-color-accent);
    text-decoration: none;
    text-underline-offset: 0.2em;
    font-weight: 550;
  }

  .rc-landing h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .rc-lede {
    margin: 1rem 0 2.25rem;
    max-width: 38em;
    font-size: 1.075rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  /* One centred column under the headline: the text inside stays left-aligned to be read. */
  .rc-why {
    max-width: 40rem;
    margin-inline: auto;
    margin-top: clamp(4rem, 10vw, 6rem);
  }
  .rc-why p {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  /* A link in the prose's own colour: the underline and the icon say it is one. */
  .rc-quiet-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--sl-color-gray-4);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 150ms ease;
  }
  .rc-quiet-link :global(.rc-quiet-link-icon) {
    color: var(--sl-color-gray-3);
  }

  /* Landing under the fixed header, not behind it. */
  #agent-setup {
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  .rc-prompt {
    position: relative;
    border-radius: 1rem;
    background: var(--sl-color-gray-6);
  }
  .rc-prompt pre {
    margin: 0;
    padding: 1.4rem 1.5rem;
    padding-right: 6rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--sl-color-gray-1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: none;
  }
  .rc-prompt-copy {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    transition: transform 160ms var(--rc-ease-out);
  }
  .rc-prompt-copy:active {
    transform: scale(var(--rc-press));
  }

  .rc-next {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
    margin: clamp(5rem, 12vw, 8rem) 0 2rem;
  }
  .rc-next a {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding: 1.1rem 1.2rem;
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
    text-decoration: none;
    transition:
      background-color 150ms ease,
      transform 160ms var(--rc-ease-out);
  }
  .rc-next a:active {
    transform: scale(var(--rc-press));
  }
  .rc-next strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .rc-next span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  /* Hover only where there is a hovering pointer: on touch, a tap would leave it stuck on. */
  @media (hover: hover) and (pointer: fine) {
    .rc-install:hover,
    .rc-next a:hover {
      background: var(--sl-color-gray-5);
    }
    .rc-install:hover .rc-copy-state,
    .rc-prompt-copy:hover .rc-copy-state {
      background: var(--sl-color-gray-4);
      color: var(--sl-color-white);
    }
    .rc-link:hover {
      text-decoration: underline;
    }
    .rc-quiet-link:hover {
      text-decoration-color: currentColor;
    }
  }

  @media (max-width: 30rem) {
    .rc-install {
      gap: 0.55rem;
      padding-left: 0.85rem;
    }
    .rc-install code {
      font-size: 0.82rem;
    }
  }

</style>
