---
/**
 * The landing page. What rulecast does and the two Claude Code commands that set it up; a
 * convention becoming a rule becoming what the agent hears; how to start setup from another agent
 * (the hero already has the Claude Code commands); and where to go next. The prompt for other
 * agents is the README's own (read at build time).
 */
import { routeUrl } from "../../scripts/links"
import { agentPrompt } from "../../scripts/sources"
import ConventionFlow from "./ConventionFlow.astro"

const install = "/plugin install rulecast --marketplace syv-ai/rulecast"
const setup = "/rulecast:setup"
const prompt = agentPrompt()
---

<div class="rc-landing not-content">
  <header class="rc-hero">
    <h1>Your project's conventions, checked while your coding agent works.</h1>
    <p class="rc-hero-where">In Claude Code:</p>
    <div class="rc-hero-commands">
      {
        [install, setup].map((command) => (
          <button class="rc-install" type="button" data-copy={command} aria-label={`Copy ${command}`}>
            <span class="rc-install-prompt" aria-hidden="true">&gt;</span>
            <code>{command}</code>
            <span class="rc-copy-state" aria-live="polite">Copy</span>
          </button>
        ))
      }
    </div>
    <p class="rc-hero-needs">Claude Code is the supported agent today, on macOS or Linux.</p>
    <div class="rc-hero-links">
      <a class="rc-link" href="#agent-setup">Another agent <span aria-hidden="true">↓</span></a>
      <a class="rc-link" href={routeUrl("getting-started")}>Read the guide <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <section>
    <h2 class="rc-h2-gap">A rule cites your docs.</h2>
    <ConventionFlow />
  </section>

  <section id="agent-setup">
    <h2>Set it up with your agent.</h2>
    <p class="rc-lede">
      In the repository you want rules in, the agent reads your code and docs, shows you one page of rules and questions,
      and writes nothing until you approve.
    </p>
    <div class="rc-setup-cols">
      <div class="rc-start">
        <p class="rc-col-label">Start it in another agent</p>
        <pre>{prompt}</pre>
        <button class="rc-prompt-copy" type="button" data-copy={prompt} aria-label="Copy the prompt">
          <span class="rc-copy-state" aria-live="polite">Copy</span>
        </button>
        <p class="rc-col-note">
          rulecast delivers rules to Claude Code only, for now. Another agent can still set up the same rules for your
          git hooks and CI.
        </p>
      </div>
    </div>
    <p class="rc-after">
      Most rules come later, one at a time. When the agent makes a mistake that should not happen again, run{" "}
      <code>/rulecast:add-rule</code>.
    </p>
  </section>

  <p class="rc-next">
    <a class="rc-link" href={routeUrl("guides/writing-rules")}>Write your first rule <span aria-hidden="true">→</span></a>
  </p>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const state = button.querySelector<HTMLElement>(".rc-copy-state")!
    let timer: ReturnType<typeof setTimeout> | undefined
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
        state.textContent = "Copied"
        button.classList.add("rc-copied")
      } catch {
        state.textContent = "Select to copy"
      }
      clearTimeout(timer)
      timer = setTimeout(() => {
        state.textContent = "Copy"
        button.classList.remove("rc-copied")
      }, 1600)
    })
  }
</script>

<style is:global>
  /* The splash page's own title panel: the hero carries the page's h1. */
  .content-panel:has(> .sl-container > h1#_top) {
    display: none;
  }
</style>

<style>
  .rc-landing {
    max-width: 52rem;
    margin: 0 auto;
  }
  .rc-landing section {
    margin-top: clamp(5rem, 12vw, 8rem);
  }
  .rc-landing h1,
  .rc-landing h2 {
    color: var(--sl-color-white);
    font-weight: 650;
    text-wrap: balance;
  }

  .rc-hero {
    margin-top: clamp(2rem, 8vw, 5rem);
    text-align: center;
  }
  .rc-hero h1 {
    margin: 0 auto;
    max-width: 16em;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .rc-hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.25rem;
  }
  .rc-install {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.8rem 0.8rem 1.1rem;
    border: 0;
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
    transition:
      transform 160ms var(--rc-ease-out),
      background-color 150ms ease;
  }
  .rc-install:active {
    transform: scale(var(--rc-press));
  }
  .rc-install code {
    white-space: nowrap;
    font-family: var(--__sl-font-mono);
    font-size: 0.95rem;
    background: none;
    padding: 0;
    color: inherit;
  }
  .rc-install-prompt {
    font-family: var(--__sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .rc-copy-state {
    min-width: 4.2rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-5);
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  /* Copied: the pill answers in the accent, so the change reads before the word does. */
  .rc-copied .rc-copy-state {
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }
  .rc-link {
    color: var(--sl-color-accent);
    text-decoration: none;
    text-underline-offset: 0.2em;
    font-weight: 550;
  }

  .rc-landing h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .rc-lede {
    margin: 1rem 0 2.25rem;
    max-width: 38em;
    font-size: 1.075rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  /* Landing under the fixed header, not behind it. */
  #agent-setup {
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  .rc-prompt-copy {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    transition: transform 160ms var(--rc-ease-out);
  }
  .rc-prompt-copy:active {
    transform: scale(var(--rc-press));
  }

  .rc-next {
    margin: clamp(4rem, 10vw, 6rem) 0 2rem;
    text-align: center;
    font-size: 1.075rem;
  }

  /* Hover only where there is a hovering pointer: on touch, a tap would leave it stuck on. */
  @media (hover: hover) and (pointer: fine) {
    .rc-install:hover {
      background: var(--sl-color-gray-5);
    }
    .rc-install:hover .rc-copy-state,
    .rc-prompt-copy:hover .rc-copy-state {
      background: var(--sl-color-gray-4);
      color: var(--sl-color-white);
    }
    .rc-link:hover {
      text-decoration: underline;
    }
  }

  @media (max-width: 30rem) {
    .rc-install {
      gap: 0.55rem;
      padding-left: 0.85rem;
    }
    .rc-install code {
      font-size: 0.82rem;
    }
  }

  .rc-hero-where {
    margin: 2.5rem 0 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  /* The commands share one width, no wider than the screen: a command too long for a phone scrolls
     inside its own button, and the copy pill stays in view. */
  .rc-hero-commands {
    display: inline-grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 100%;
    gap: 0.5rem;
  }
  .rc-hero-commands .rc-install {
    min-width: 0;
  }
  .rc-hero-commands .rc-install code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    text-align: left;
  }
  .rc-install-prompt,
  .rc-copy-state {
    flex-shrink: 0;
  }
  .rc-hero-needs {
    margin: 1.25rem auto 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .rc-h2-gap {
    margin-bottom: 2.25rem !important;
  }
  .rc-after {
    margin: 1.5rem 0 0;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  .rc-setup-cols {
    margin-top: 1.5rem;
    display: grid;
    /* minmax(0, …): the prompt scrolls inside its box rather than widening the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .rc-start {
    position: relative;
    padding: 1.1rem 1.25rem;
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
  }
  .rc-start pre {
    margin: 0;
    padding: 0 4.5rem 0 0;
    background: none;
    font-family: var(--__sl-font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--sl-color-gray-1);
    white-space: pre;
    overflow-x: auto;
  }
  .rc-col-label {
    margin: 0 0 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .rc-col-note {
    margin: 1rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
</style>
