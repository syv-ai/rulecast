---
/**
 * The landing page. The name and the two Claude Code commands that set rulecast up; what it is, in
 * plain words; a convention becoming a rule becoming what the agent hears; what setup is like, and
 * how to start it from another agent (the hero already has the Claude Code commands); where it
 * runs. The prompt for other agents is the README's own (read at build time).
 */
import { routeUrl } from "../../scripts/links"
import { agentPrompt } from "../../scripts/sources"
import ConventionFlow from "./ConventionFlow.astro"
import HookFlow from "./HookFlow.astro"

const install = "/plugin install rulecast --marketplace syv-ai/rulecast"
const setup = "/rulecast:setup"
const prompt = agentPrompt()
const steps = [
  {
    title: "It reads the repository first",
    text: "Then it asks what it can't tell: who works on it, where configs go, where your conventions live, and which of your git hooks to run as rules.",
  },
  {
    title: "It shows you one page",
    text: "Everything you agreed, and every file it would change. Nothing is written until you approve.",
  },
  {
    title: "It installs rulecast and runs init",
    text: "A rulecast already installed, else a devDependency where package.json pins the tools, else the standalone binary. You review the changes and commit them.",
  },
]
const next = [
  { title: "Getting started", text: "Your agent sets it up with you.", route: "getting-started" },
  { title: "Writing rules", text: "A check, a message, a doc section.", route: "guides/writing-rules" },
  { title: "Git hooks and CI", text: "The same rules, everywhere.", route: "guides/git-hooks-ci" },
  { title: "Claude Code plugin", text: "Add one rule at a time.", route: "guides/claude-code-plugin" },
]
---

<div class="rc-landing not-content">
  <header class="rc-hero">
    <h1>rulecast</h1>
    <p class="rc-hero-tagline">Your project's conventions, checked while your coding agent works.</p>
    <p class="rc-hero-where">In Claude Code:</p>
    <div class="rc-hero-commands">
      {
        [install, setup].map((command) => (
          <button class="rc-install" type="button" data-copy={command} aria-label={`Copy ${command}`}>
            <span class="rc-install-prompt" aria-hidden="true">&gt;</span>
            <code>{command}</code>
            <span class="rc-copy-state" aria-live="polite">Copy</span>
          </button>
        ))
      }
    </div>
    <p class="rc-hero-needs">Claude Code is the supported agent today. Needs Node 20.12 or later, on macOS or Linux.</p>
    <div class="rc-hero-links">
      <a class="rc-link" href="#agent-setup">Another agent <span aria-hidden="true">↓</span></a>
      <a class="rc-link" href={routeUrl("getting-started")}>Read the guide <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <section class="rc-why">
    <p>
      rulecast runs as your coding agent's hooks. When an edit breaks one of your project's rules, the agent is told in
      the same turn, along with the part of your docs the rule comes from, so it can fix the code before it moves on.
    </p>
  </section>

  <section>
    <h2 class="rc-h2-gap">A rule cites your docs.</h2>
    <ConventionFlow />
  </section>

  <section id="agent-setup">
    <h2>Set it up with your agent.</h2>
    <p class="rc-lede">A short conversation, in the repository you want rules in. Nothing is written until you approve.</p>
    <ol class="rc-steps">
      {
        steps.map((step) => (
          <li>
            <strong>{step.title}</strong>
            <span>{step.text}</span>
          </li>
        ))
      }
    </ol>
    <div class="rc-setup-cols">
      <div class="rc-start">
        <p class="rc-col-label">Start it in another agent</p>
        <pre>{prompt}</pre>
        <button class="rc-prompt-copy" type="button" data-copy={prompt} aria-label="Copy the prompt">
          <span class="rc-copy-state" aria-live="polite">Copy</span>
        </button>
        <p class="rc-col-note">
          rulecast delivers rules to Claude Code only, for now. Another agent can still set up the same rules for your
          git hooks and CI.
        </p>
      </div>
    </div>
    <p class="rc-after">
      Most rules come later, one at a time. When the agent makes a mistake that should not happen again, run{" "}
      <code>/rulecast:add-rule</code>.
    </p>
  </section>

  <section>
    <h2>Around the tools it already uses.</h2>
    <p class="rc-lede">rulecast runs as your agent's hooks, with nothing to start. The same rules run in git hooks and CI.</p>
    <HookFlow />
  </section>

  <nav class="rc-next" aria-label="Read on">
    {
      next.map((item) => (
        <a href={routeUrl(item.route)}>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </a>
      ))
    }
  </nav>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const state = button.querySelector<HTMLElement>(".rc-copy-state")!
    let timer: ReturnType<typeof setTimeout> | undefined
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
        state.textContent = "Copied"
        button.classList.add("rc-copied")
      } catch {
        state.textContent = "Select to copy"
      }
      clearTimeout(timer)
      timer = setTimeout(() => {
        state.textContent = "Copy"
        button.classList.remove("rc-copied")
      }, 1600)
    })
  }
</script>

<style is:global>
  /* The splash page's own title panel: the hero carries the page's h1. */
  .content-panel:has(> .sl-container > h1#_top) {
    display: none;
  }
</style>

<style>
  .rc-landing {
    max-width: 52rem;
    margin: 0 auto;
  }
  .rc-landing section {
    margin-top: clamp(5rem, 12vw, 8rem);
  }
  .rc-landing h1,
  .rc-landing h2 {
    color: var(--sl-color-white);
    font-weight: 650;
    text-wrap: balance;
  }

  .rc-hero {
    margin-top: clamp(2rem, 8vw, 5rem);
    text-align: center;
  }
  .rc-hero h1 {
    margin: 0 auto;
    max-width: 14em;
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .rc-hero-tagline {
    margin: 1.5rem auto 0;
    max-width: 34em;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .rc-hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.25rem;
  }
  .rc-install {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.8rem 0.8rem 1.1rem;
    border: 0;
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
    transition:
      transform 160ms var(--rc-ease-out),
      background-color 150ms ease;
  }
  .rc-install:active {
    transform: scale(var(--rc-press));
  }
  .rc-install code {
    white-space: nowrap;
    font-family: var(--__sl-font-mono);
    font-size: 0.95rem;
    background: none;
    padding: 0;
    color: inherit;
  }
  .rc-install-prompt {
    font-family: var(--__sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .rc-copy-state {
    min-width: 4.2rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-5);
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }
  /* Copied: the pill answers in the accent, so the change reads before the word does. */
  .rc-copied .rc-copy-state {
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }
  .rc-link {
    color: var(--sl-color-accent);
    text-decoration: none;
    text-underline-offset: 0.2em;
    font-weight: 550;
  }

  .rc-landing h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .rc-lede {
    margin: 1rem 0 2.25rem;
    max-width: 38em;
    font-size: 1.075rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  /* One centred column under the headline: the text inside stays left-aligned to be read. */
  .rc-why {
    max-width: 40rem;
    margin-inline: auto;
    margin-top: clamp(4rem, 10vw, 6rem);
  }
  .rc-why p {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }


  /* Landing under the fixed header, not behind it. */
  #agent-setup {
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  .rc-prompt-copy {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    transition: transform 160ms var(--rc-ease-out);
  }
  .rc-prompt-copy:active {
    transform: scale(var(--rc-press));
  }

  .rc-next {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
    margin: clamp(5rem, 12vw, 8rem) 0 2rem;
  }
  .rc-next a {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding: 1.1rem 1.2rem;
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
    text-decoration: none;
    transition:
      background-color 150ms ease,
      transform 160ms var(--rc-ease-out);
  }
  .rc-next a:active {
    transform: scale(var(--rc-press));
  }
  .rc-next strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .rc-next span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  /* Hover only where there is a hovering pointer: on touch, a tap would leave it stuck on. */
  @media (hover: hover) and (pointer: fine) {
    .rc-install:hover,
    .rc-next a:hover {
      background: var(--sl-color-gray-5);
    }
    .rc-install:hover .rc-copy-state,
    .rc-prompt-copy:hover .rc-copy-state {
      background: var(--sl-color-gray-4);
      color: var(--sl-color-white);
    }
    .rc-link:hover {
      text-decoration: underline;
    }
  }

  @media (max-width: 30rem) {
    .rc-install {
      gap: 0.55rem;
      padding-left: 0.85rem;
    }
    .rc-install code {
      font-size: 0.82rem;
    }
  }


  .rc-hero-where {
    margin: 2.5rem 0 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  /* The commands share one width, no wider than the screen: a command too long for a phone scrolls
     inside its own button, and the copy pill stays in view. */
  .rc-hero-commands {
    display: inline-grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 100%;
    gap: 0.5rem;
  }
  .rc-hero-commands .rc-install {
    min-width: 0;
  }
  .rc-hero-commands .rc-install code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    text-align: left;
  }
  .rc-install-prompt,
  .rc-copy-state {
    flex-shrink: 0;
  }
  .rc-hero-needs {
    margin: 1.25rem auto 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .rc-h2-gap {
    margin-bottom: 2.25rem !important;
  }
  .rc-steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .rc-steps li {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1.25rem 1.1rem 3.25rem;
    position: relative;
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
    counter-increment: step;
  }
  .rc-steps li::before {
    content: counter(step);
    position: absolute;
    left: 1.2rem;
    top: 1.15rem;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    display: grid;
    place-items: center;
  }
  .rc-steps strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .rc-steps span {
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  .rc-after {
    margin: 1.5rem 0 0;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  .rc-setup-cols {
    margin-top: 1.5rem;
    display: grid;
    /* minmax(0, …): the prompt scrolls inside its box rather than widening the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .rc-start {
    position: relative;
    padding: 1.1rem 1.25rem;
    border-radius: 0.875rem;
    background: var(--sl-color-gray-6);
  }
  .rc-start pre {
    margin: 0;
    padding: 0 4.5rem 0 0;
    background: none;
    font-family: var(--__sl-font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--sl-color-gray-1);
    white-space: pre;
    overflow-x: auto;
  }
  .rc-col-label {
    margin: 0 0 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .rc-col-note {
    margin: 1rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
</style>
