{
  "name": "@syv-ai/rulecast",
  "version": "0.0.0",
  "description": "Deliver project conventions to coding agents at the moment they matter.",
  "keywords": [
    "claude-code",
    "coding-agent",
    "coding-agents",
    "conventions",
    "lint",
    "hooks",
    "ast-grep",
    "agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/syv-ai/rulecast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syv-ai/rulecast.git",
    "directory": "packages/rulecast"
  },
  "bugs": "https://github.com/syv-ai/rulecast/issues",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "rulecast": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "binary": "tsx scripts/build-binary.ts",
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "manifest": "tsx scripts/generate-manifest.ts",
    "readme": "tsx scripts/readme.ts",
    "release-notes": "tsx scripts/release-notes.ts",
    "sync-version": "tsx scripts/sync-version.ts",
    "test": "vitest run",
    "test:perf": "RULECAST_PERF=1 vitest run test/perf",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/napi": "^0.45.3",
    "@clack/prompts": "^1.8.1",
    "diff": "^8.0.4",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxlint": "^1.83.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
