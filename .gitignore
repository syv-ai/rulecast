node_modules/
dist/

# Standalone binaries, built by `pnpm binary` and attached to GitHub Releases.
binaries/

# Benchmark output, written by `pnpm bench`. The numbers belong to the machine that ran them.
packages/rulecast/bench/

# Stress output, written by `pnpm stress`. Same reason: one machine's numbers, under load.
packages/rulecast/stress/

# Personal agent settings and agent worktrees. .claude/settings.json is shared and stays tracked;
# these were only invisible because of this machine's global gitignore and .git/info/exclude.
.claude/settings.local.json
.claude/worktrees/

# Not ours.
.dash/

# Credentials. Nothing here is ever committed, whatever a tool writes into it.
.env
.env.*
!.env.example
